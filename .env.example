# --- Telegram: два бота ---
# Бот №1 — каталог и подбор
CATALOG_BOT_TOKEN=123456:CATALOG_TOKEN_HERE
# Бот №2 — заказы (корзина, личный кабинет)
ORDER_BOT_TOKEN=123456:ORDER_TOKEN_HERE
# username второго бота без @ (для кнопки "Заказать")
ORDER_BOT_USERNAME=your_order_bot
# старый ключ оставлен для совместимости, равен каталогу
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

ADMIN_IDS=123456789

DATABASE_URL=postgresql+asyncpg://autoparts:autoparts_secret@db:5432/autoparts
# локально без PostgreSQL:
# DATABASE_URL=sqlite+aiosqlite:///./bot.db

SHOP_NAME=АвтоЗапчасти
SUPPORT_USERNAME=support_username

# --- Web admin (один админ, Basic Auth) ---
WEB_HOST=127.0.0.1
WEB_PORT=8000
WEB_ADMIN_USER=admin
WEB_ADMIN_PASSWORD=change_me_please
WEB_PUBLIC_URL=http://127.0.0.1:8000

# --- VIN auto-decode (NHTSA, бесплатно, без ключа) ---
VIN_DECODE_ENABLED=true

# --- Фото через ИИ (пример: бесплатный Gemini, OpenAI-совместимый) ---
# PHOTO_AI_API_KEY=AIza...
# PHOTO_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# PHOTO_AI_MODEL=gemini-3.1-flash-lite
